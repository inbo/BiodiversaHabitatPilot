# Mask out the polygon
obj_poly <-
obj_clear |>
st_crop(AOI)
rm(obj_clear) # we won't use this object anymore.
# Convert stars object to a data frame for prediction
obj_df <- as.data.frame(obj_poly)
# Convert stars object to a data frame for prediction
